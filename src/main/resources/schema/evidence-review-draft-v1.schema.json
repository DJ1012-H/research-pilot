{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-pilot.local/schema/evidence-review-draft-v1.schema.json",
  "title": "Research Pilot Evidence Review Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["statements"],
  "properties": {
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "citationIds"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["METHOD", "TREND", "OBSERVATION", "LIMITATION"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "citationIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P[1-9][0-9]*$"
            }
          }
        }
      }
    }
  }
}
