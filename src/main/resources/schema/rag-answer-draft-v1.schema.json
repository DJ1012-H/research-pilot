{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["statements"],
  "properties": {
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "citationIds"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "citationIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P[1-9][0-9]*$"
            }
          }
        }
      }
    }
  }
}
