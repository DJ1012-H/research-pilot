{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["relevant", "admittedEvidenceIds", "reason"],
  "properties": {
    "relevant": {
      "type": "boolean"
    },
    "admittedEvidenceIds": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P[1-5]$"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"relevant": {"const": true}},
        "required": ["relevant"]
      },
      "then": {
        "properties": {"admittedEvidenceIds": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {"relevant": {"const": false}},
        "required": ["relevant"]
      },
      "then": {
        "properties": {"admittedEvidenceIds": {"maxItems": 0}}
      }
    }
  ]
}
