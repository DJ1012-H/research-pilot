{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-pilot.local/schema/search-plan-v1.schema.json",
  "title": "Research Pilot Search Plan Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "englishKeywords",
    "searchQuery",
    "languages",
    "publicationTypes",
    "sort",
    "recentYears",
    "fromYear",
    "toYear",
    "resultLimit"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "englishKeywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "searchQuery": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "languages": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["en", "zh"]
      }
    },
    "publicationTypes": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["article", "review", "preprint", "book-chapter", "dissertation", "report"]
      }
    },
    "sort": {
      "type": ["string", "null"],
      "enum": ["relevance", "newest", "most_cited", null]
    },
    "recentYears": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100
    },
    "fromYear": {
      "type": ["integer", "null"],
      "minimum": 1900,
      "maximum": 2100
    },
    "toYear": {
      "type": ["integer", "null"],
      "minimum": 1900,
      "maximum": 2100
    },
    "resultLimit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 15
    }
  }
}
