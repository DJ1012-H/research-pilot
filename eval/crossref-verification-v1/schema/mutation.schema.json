{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutation.schema.json",
  "title": "Crossref Verification Mutation Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["mutation_set", "mutations"],
  "properties": {
    "mutation_set": {"type": "string", "minLength": 1},
    "mutations": {
      "type": "array",
      "items": {"$ref": "#/$defs/mutation"}
    }
  },
  "$defs": {
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "category", "target", "precondition", "operation", "parameters", "expected_effect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "category": {"enum": ["EQUIVALENT", "EXPLAINABLE", "CONFLICT"]},
        "target": {"type": "string", "minLength": 1},
        "precondition": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "expected_effect": {"type": "object", "additionalProperties": false,
          "required": ["field_status", "verification_status_change"],
          "properties": {
            "field_status": {"enum": ["MATCHED", "EXPLAINABLE_DIFFERENCE", "MISMATCHED", "UNKNOWN"]},
            "verification_status_change": {"enum": ["NONE", "POLICY_DECIDES"]}
          }
        }
      }
    }
  }
}
