{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchpilot.local/crossref-verification-v1/policy-benchmark-result.schema.json",
  "title": "Crossref verification policy benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_version",
    "dataset_version",
    "split_version",
    "production_baseline_commit",
    "policy_class",
    "formal_admission_oracle",
    "legacy_formal_result_eligible_handling",
    "evaluated_case_count",
    "calibration_case_count",
    "acceptance_case_count",
    "overall_status_match_count",
    "calibration_status_match_count",
    "acceptance_status_match_count",
    "formal_admission_match_count",
    "false_verified_count",
    "false_formal_admission_count",
    "false_formal_exclusion_count",
    "exception_count",
    "acceptance_passed",
    "failure_reasons",
    "case_results"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "crossref-policy-benchmark-result-v0.1"},
    "benchmark_version": {"type": "string", "const": "v0.1"},
    "dataset_version": {"type": "string", "const": "crossref-verification-v1"},
    "split_version": {"type": "string", "const": "v0.1"},
    "production_baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy_class": {"type": "string", "minLength": 1},
    "formal_admission_oracle": {"type": "string", "minLength": 1},
    "legacy_formal_result_eligible_handling": {"type": "string", "const": "DIAGNOSTIC_ONLY"},
    "evaluated_case_count": {"type": "integer", "minimum": 0},
    "calibration_case_count": {"type": "integer", "minimum": 0},
    "acceptance_case_count": {"type": "integer", "minimum": 0},
    "overall_status_match_count": {"type": "integer", "minimum": 0},
    "calibration_status_match_count": {"type": "integer", "minimum": 0},
    "acceptance_status_match_count": {"type": "integer", "minimum": 0},
    "formal_admission_match_count": {"type": "integer", "minimum": 0},
    "false_verified_count": {"type": "integer", "minimum": 0},
    "false_formal_admission_count": {"type": "integer", "minimum": 0},
    "false_formal_exclusion_count": {"type": "integer", "minimum": 0},
    "exception_count": {"type": "integer", "minimum": 0},
    "acceptance_passed": {"type": "boolean"},
    "failure_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "case_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "split",
          "expected_status",
          "actual_status",
          "status_match",
          "expected_formal_admission",
          "actual_formal_admission",
          "admission_match",
          "false_verified",
          "false_formal_admission",
          "false_formal_exclusion",
          "legacy_formal_result_eligible",
          "actual_reference_doi",
          "policy_reasons",
          "error_code"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^crv1-case-[0-9]{4}$"},
          "split": {"type": "string", "enum": ["CALIBRATION", "ACCEPTANCE"]},
          "expected_status": {"type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "CONFLICTED", "REJECTED"]},
          "actual_status": {"type": ["string", "null"]},
          "status_match": {"type": "boolean"},
          "expected_formal_admission": {"type": "boolean"},
          "actual_formal_admission": {"type": ["boolean", "null"]},
          "admission_match": {"type": "boolean"},
          "false_verified": {"type": "boolean"},
          "false_formal_admission": {"type": "boolean"},
          "false_formal_exclusion": {"type": "boolean"},
          "legacy_formal_result_eligible": {"type": "boolean"},
          "actual_reference_doi": {"type": ["string", "null"]},
          "policy_reasons": {"type": "array", "items": {"type": "string"}},
          "error_code": {"type": ["string", "null"]}
        }
      }
    }
  }
}
