{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchpilot.local/crossref-verification-v2/review-queue-case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "review_state", "input", "expected", "provenance", "notes"],
  "properties": {
    "schema_version": {"type": "string", "const": "crossref-verification-v2-review-queue"},
    "case_id": {"type": "string", "pattern": "^crv2-case-[0-9]{4}$"},
    "review_state": {"type": "string", "const": "NEEDS_REVIEW"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_source_id", "reference_source_ids"],
      "properties": {
        "candidate_source_id": {"type": "string", "minLength": 1},
        "reference_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_status", "formal_admission", "field_oracles"],
      "properties": {
        "policy_status": {"type": "null"},
        "formal_admission": {"type": "null"},
        "field_oracles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doi", "title", "first_author", "authors", "year", "venue", "work_type"],
          "properties": {
            "doi": {"type": "null"},
            "title": {"type": "null"},
            "first_author": {"type": "null"},
            "authors": {"type": "null"},
            "year": {"type": "null"},
            "venue": {"type": "null"},
            "work_type": {"type": "null"}
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "review"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "role", "snapshot_path", "source_url", "retrieved_at", "sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "role": {"type": "string", "enum": ["CANDIDATE", "REFERENCE"]},
              "snapshot_path": {"type": "string", "minLength": 1},
              "source_url": {"type": "string", "format": "uri"},
              "retrieved_at": {"type": "string", "format": "date-time"},
              "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
            }
          }
        },
        "review": {"type": "null"}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
