# Copy only the variable names you need into your local process environment.
# This file is a reference and is not loaded automatically by Spring Boot.
# Never replace placeholder values here with real credentials or personal contact data.

# MySQL 8 (required only for FullDemo persistence)
MYSQL_URL=jdbc:mysql://localhost:3306/research_pilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=research_pilot
MYSQL_PASSWORD=CHANGE_ME

# Immutable Flyway migrations and runtime persistence are opt-in.
FLYWAY_ENABLED=false
LITERATURE_PERSISTENCE_ENABLED=false

# Redis is required only when LITERATURE_CACHE_ENABLED=true.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
LITERATURE_CACHE_ENABLED=false
LITERATURE_CACHE_KEY_PREFIX=research-pilot:literature:v1
OPENALEX_CACHE_TTL=15m
CROSSREF_CACHE_TTL=24h
CROSSREF_NOT_FOUND_CACHE_TTL=5m
LITERATURE_CACHE_FAILURE_COOLDOWN=30s
LITERATURE_CACHE_MAX_PAYLOAD_BYTES=2097152

# OpenAI-compatible LLM (required only for live trusted search)
LLM_ENABLED=false
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL_NAME=CHANGE_ME
LLM_TIMEOUT=60s
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# OpenAlex candidate retrieval (API key is optional)
OPENALEX_ENABLED=false
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_CONNECT_TIMEOUT=3s
OPENALEX_READ_TIMEOUT=10s
OPENALEX_DEFAULT_PAGE_SIZE=25

# Crossref verification (a real contact address is required only when enabled)
CROSSREF_ENABLED=false
CROSSREF_MAILTO=your-email@example.com
CROSSREF_USER_AGENT=ResearchPilot/0.1
CROSSREF_PLUS_TOKEN=
LITERATURE_MAX_CROSSREF_LOOKUPS=10

# Qdrant/embedding/RAG settings are intentionally absent: they are not implemented.
