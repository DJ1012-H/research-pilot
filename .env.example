# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/research_pilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=research_pilot
MYSQL_PASSWORD=CHANGE_ME

# Redis (can point to another host on your private network)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# OpenAI-compatible chat model
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL_NAME=CHANGE_ME
LLM_TIMEOUT=60s
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# OpenAlex candidate retrieval
OPENALEX_ENABLED=false
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=CHANGE_ME
OPENALEX_CONNECT_TIMEOUT=3s
OPENALEX_READ_TIMEOUT=10s
OPENALEX_DEFAULT_PAGE_SIZE=25

# Qdrant vector database
# Reserved for phase 3; not used during phase 1.
QDRANT_ENABLED=false
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=research_paper_chunks
